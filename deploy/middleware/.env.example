# Copy to .env (same directory as docker-compose.middleware.yaml) and adjust:
#   cp deploy/middleware/.env.example deploy/middleware/.env
#
# EVERY value here is OPTIONAL. The compose file carries the same defaults via
# ${VAR:-default}, so `make middleware-up` works with no .env at all. Put real
# secrets in .env (it is git-ignored) or source them from your secret manager —
# never commit a filled-in .env.

# --- Shared ---
# Container timezone.
TZ=Asia/Shanghai

# --- MySQL ---
# Defaults match configs/user_center.yaml's DSN: root:123456@.../user_center.
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=user_center
MYSQL_PORT=3306
# Optional scoped account (left empty = NOT created). Business-DB example:
#   MYSQL_DATABASE=shop_biz
#   MYSQL_USER=biz_user
#   MYSQL_PASSWORD=Biz@Pass2026
# If you create one, point the service at it with KRATOS_DB_SOURCE, e.g.:
#   KRATOS_DB_SOURCE='biz_user:Biz@Pass2026@tcp(127.0.0.1:3306)/shop_biz?parseTime=true&loc=Local'
MYSQL_USER=
MYSQL_PASSWORD=

# --- Redis ---
REDIS_PORT=6379
REDIS_MAXMEMORY=768mb

# --- Nacos ---
NACOS_PORT=8848
NACOS_JVM_XMS=512m
NACOS_JVM_XMX=512m
NACOS_JVM_XMN=256m
# Auth is OFF locally so configs/*.yaml (empty username/password) and the gateway
# work unchanged. To enable it you MUST do all three:
#   1. set NACOS_AUTH_ENABLE=true,
#   2. fill the three NACOS_AUTH_* secrets below,
#   3. set registry.username / registry.password (default nacos/nacos) in every
#      service config (configs/*.yaml) or in the Nacos config center.
NACOS_AUTH_ENABLE=false
# NACOS_AUTH_TOKEN: Base64-encoded key used to sign the console/API JWT. It must
# decode to >= 32 bytes. Generate one with:
#   openssl rand -base64 32
NACOS_AUTH_TOKEN=
# Server-identity key/value pair Nacos uses to trust cluster-internal calls. Any
# non-empty custom strings; keep them secret. Generate a value with:
#   openssl rand -hex 16
# e.g. NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

# --- Elasticsearch + Kibana (only used with `--profile search`) ---
# ES needs vm.max_map_count >= 262144 on the host:
#   sudo sysctl -w vm.max_map_count=262144
ES_PORT=9200
KIBANA_PORT=5601
ES_MEM_XMS=1g
ES_MEM_XMX=1g
# Bootstrap password for the `elastic` superuser. CHANGE THIS. Generate one with:
#   openssl rand -base64 24
ELASTIC_PASSWORD=changeme
