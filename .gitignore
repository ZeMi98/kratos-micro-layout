# Reference https://github.com/github/gitignore/blob/master/Go.gitignore
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/
bin
# Go workspace: go.work IS committed on purpose — the app/user_center nested
# module resolves the root module (api/, pkg/) only through it. Ignore just the
# derived checksum file.
go.work.sum

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a
*.so

# OS General
Thumbs.db
.DS_Store

# project
*.cert
*.key
*.log
# stray local database files left behind by a smoke test
*.db
# staging dir for per-domain OpenAPI generation (`make api` moves these into pkg/docs/specs/)
.oapi/

# Develop tools
.vscode/
.idea/
*.swp
